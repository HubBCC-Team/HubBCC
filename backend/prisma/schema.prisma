generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id               Int            @id @default(autoincrement())
  nome             String
  email            String         @unique
  senhaHash        String
  perfil           String         @default("aluno")
  matricula        String?        @unique
  curso            String         @default("Bacharelado em Ciencia da Computacao")
  periodo          String?
  telefone         String         @default("")
  iniciais         String         @default("")
  refreshTokenHash String?

  candidaturas  Candidatura[]
  oportunidades Oportunidade[] @relation("OportunidadeCriador")
  agendamentos  Agendamento[]
  atividades    Atividade[]
}

model Oportunidade {
  id             Int           @id @default(autoincrement())
  titulo         String
  tipo           String
  area           String
  departamento   String
  responsavel    String
  modalidade     String
  local          String
  bolsa          String        @default("")
  cargaHoraria   String        @default("")
  vagas          Int
  prazoInscricao DateTime      @db.Date
  descricao      String
  requisitos     String[]      @default([])
  atividades     String[]      @default([])
  situacao       String        @default("Aberta")

  criadorId Int?
  criador   Usuario? @relation("OportunidadeCriador", fields: [criadorId], references: [id], onDelete: SetNull)

  candidaturas Candidatura[]
}

model Candidatura {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  oportunidadeId Int
  carta          String
  situacao       String   @default("Em analise")
  dataEnvio      DateTime @default(now()) @db.Date

  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  oportunidade Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, oportunidadeId])
}

model Agendamento {
  id             Int      @id @default(autoincrement())
  usuarioId      Int
  ofertaId       Int
  monitorId      Int?
  titulo         String
  disciplina     String
  monitor        String
  modalidade     String
  local          String
  data           DateTime @db.Date
  hora           String
  situacao       String   @default("Confirmado")
  idempotencyKey String?
  criadoEm       DateTime @default(now())

  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  atendimento Atendimento?

  @@unique([usuarioId, idempotencyKey])
  @@index([ofertaId, situacao])
  @@index([monitorId])
}

model Atendimento {
  id            Int      @id @default(autoincrement())
  agendamentoId Int      @unique
  registro      Json
  avaliacao     Json?
  criadoEm      DateTime @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
}

model Disciplina {
  id     Int     @id @default(autoincrement())
  codigo String? @unique
  nome   String  @unique
  ativa  Boolean @default(true)

  atividades Atividade[]
}

model Atividade {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int
  disciplinaId       Int?
  categoria          String
  titulo             String
  data               DateTime @db.Date
  horas              Int
  descricao          String   @default("")
  situacao           String   @default("Em analise")
  observacao         String   @default("")
  comprovante        String   @default("")
  comprovantePath    String?
  comprovanteMime    String?
  comprovanteTamanho Int?
  criadoEm           DateTime @default(now())

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  disciplina Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, situacao])
}