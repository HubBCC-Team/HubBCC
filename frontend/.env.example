# Copie este arquivo para ".env" caso precise mudar a configuracao.
# Sem o .env, o front ja usa o valor padrao abaixo.

# Endereco do backend mockado (JSON Server - rode "npm run server")
VITE_API_URL=http://localhost:3001

# Porta do JSON Server (opcional; usada por server/server.js)
PORTA_API=3001
