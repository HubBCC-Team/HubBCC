# Copie este arquivo para ".env" caso precise mudar a configuracao.
# Enquanto nao houver backend, NAO e necessario criar o .env: os valores
# padrao ja deixam o modo mock ligado.

# Endereco do backend real
VITE_API_URL=http://localhost:8080/api

# true  = usa o servidor falso (src/mocks/db.js)
# false = fala com o backend real do VITE_API_URL
VITE_USAR_MOCK=true
